{
  "name": "eduvereda-multiplatform-demo",
  "version": "1.0.0",
  "private": true,
  "description": "Sistema multiplataforma Offline-First EduVereda (Estudiante + Docente / VeredaSync) con Clean Architecture en React Native + Expo Web",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "export:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "audit:sec": "pnpm audit --prod"
  },
  "dependencies": {
    "@expo/metro-runtime": "^58.0.17",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "expo": "~58.0.23",
    "expo-camera": "^58.0.14",
    "expo-crypto": "^58.0.7",
    "expo-file-system": "^58.0.13",
    "expo-haptics": "^58.0.7",
    "expo-sharing": "^58.0.22",
    "expo-sqlite": "^58.0.15",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-qrcode-svg": "^6.3.15",
    "react-native-svg": "^15.11.2",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
